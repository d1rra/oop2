class Monster:
    def __init__(self, name, hp, dmg):
        self.name = name
        self.hp = hp
        self.dmg = dmg

    def get_name(self):
        return self.name

    def get_hp(self):
        return self.hp

    def get_dmg(self):
        return self.dmg

    def set_hp(self, value):
        if value < 0:
            self.hp = 0
        else:
            self.hp = value

    def is_alive(self):
        return self.hp > 0

    def show_status(self):
        print(f"Имя: {self.name}, Количество здоровья: {self.hp}")


m = Monster("Зомби", 100, 10)
m.show_status()
m.set_hp(-50)
m.show_status()
print(m.is_alive())
