import random

class Monster:
    def __init__(self, name, hp, dmg):
        self.name = name
        self.hp = hp
        self.dmg = dmg

    def take_damage(self, damage):
        self.hp -= damage
        print(f"{self.name} получает {damage} урона. У него {self.hp} ХП.")

    def attack_hunter(self, hunter):
        hunter.hp -= self.dmg
        print(f"{self.name} атакует охотника на {self.dmg} урона. У него {self.hp} ХП.")

class Zombie(Monster):
    def __init__(self):
        super().__init__(name="Зомби", hp=120, dmg=10)

    def take_damage(self, damage):
        self.hp -= damage
        print(f"{self.name} теряет {damage} ХП. Сейчас у него {self.hp} ХП.")

class Vampire(Monster):
    def __init__(self):
        super().__init__(name="Дракула", hp=80, dmg=15)

    def take_damage(self, damage):
        self.hp -= (damage - 5)
        print(f"{self.name} поглощает 5 урона! Получено {damage - 5} урона. Сейчас у него {self.hp} ХП.")

class Ghost(Monster):
    def __init__(self):
        super().__init__(name="Призрак", hp=60, dmg=20)

    def take_damage(self, damage):
        if random.random() < 0.3:
            print(f"{self.name} уклонился!")
        else:
            self.hp -= damage
            print(f"{self.name} теряет {damage} ХП. Сейчас у него {self.hp} ХП.")

class Werewolf(Monster):
    def __init__(self):
        super().__init__(name="Оборотень", hp=100, dmg=25)

    def take_damage(self, damage):
        self.hp -= damage
        print(f"{self.name} теряет {damage} ХП. Сейчас у него {self.hp} ХП.")
        if self.hp < 50:
            print(f"{self.name} трансформируется!")

z = Zombie()
z.take_damage(30)
# Зомби теряет конечность! Получено: 30. HP: 90

v = Vampire()
v.take_damage(30)
# Дракула поглощает 5 урона! Получено: 25. HP: 55

g = Ghost()
g.take_damage(30)

w = Werewolf()
w.take_damage(51)
